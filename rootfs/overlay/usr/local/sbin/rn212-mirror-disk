#!/bin/sh
# rn212-mirror-disk: run ONCE on Debian after the first successful boot.
#
# The installer put Debian on one disk only (degraded RAID1 /dev/md9). This
# script WIPES THE OTHER DISK (the old stock ReadyNAS OS disk), copies the
# partition layout onto it, adds it to the root mirror and creates the
# mirrored data array /dev/md10 (ext4, mounted on /srv/data).
set -eu

die() { echo "rn212-mirror-disk: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"

# Disk that holds the running root (member of md9).
root_part=$(mdadm --detail /dev/md9 | awk '/active sync/ { print $NF; exit }')
[ -n "$root_part" ] || die "cannot find an active member of /dev/md9"
# -d: without it lsblk also lists the partition's holders (md9) and prints
# more than one line, which made src garbage and dst the root disk.
src=/dev/$(lsblk -ndo PKNAME "$root_part")
[ -b "$src" ] || die "cannot work out the disk under $root_part (got '$src')"

# The other internal disk.
dst=
for d in /dev/sda /dev/sdb; do
	[ -b "$d" ] && [ "$d" != "$src" ] && dst=$d
done
[ -n "$dst" ] || die "no second disk found"
case "$root_part" in
"$dst"*) die "refusing: $dst holds the running root ($root_part)" ;;
esac

src_size=$(blockdev --getsize64 "$src")
dst_size=$(blockdev --getsize64 "$dst")
[ "$dst_size" -ge "$src_size" ] ||
	die "$dst ($dst_size bytes) is smaller than $src ($src_size bytes)"

echo "Root (Debian) disk : $src"
echo "Disk to be WIPED   : $dst"
lsblk -o NAME,SIZE,MODEL,SERIAL "$dst"
smartctl -H "$dst" | grep -i 'overall-health' ||
	echo "(no SMART health verdict for $dst; check it with smartctl -a)"
printf 'Type WIPE to erase %s and mirror onto it: ' "$dst"
read -r answer
[ "$answer" = WIPE ] || die "aborted"

# Stop anything the old stock OS left assembled on that disk.
for md in $(awk '/^md/ { print $1 }' /proc/mdstat); do
	[ "$md" = md9 ] && continue
	if mdadm --detail "/dev/$md" 2>/dev/null | grep -q "$dst"; then
		umount "/dev/$md" 2>/dev/null || true
		mdadm --stop "/dev/$md"
	fi
done
swapoff -a 2>/dev/null || true

for p in "$dst"?*; do
	[ -b "$p" ] && mdadm --zero-superblock "$p" 2>/dev/null || true
done
wipefs -a "$dst"
sgdisk --zap-all "$dst"
sgdisk -R "$dst" "$src"      # copy partition table src -> dst
sgdisk -G "$dst"             # new GUIDs
partprobe "$dst"; udevadm settle
# Old stock filesystems (btrfs/ext4) can sit at the same offsets as the new
# partitions; clear them so mdadm/mkfs don't stop to ask.
wipefs -a "${dst}1" "${dst}2"

mdadm /dev/md9 --add "${dst}1"

# Data array on partition 2 of both disks.
src_data=${src}2; dst_data=${dst}2
if ! mdadm --detail /dev/md10 >/dev/null 2>&1; then
	mdadm --zero-superblock "$src_data" 2>/dev/null || true
	mdadm --create /dev/md10 --run --metadata=1.2 --level=1 --raid-devices=2 \
		--bitmap=internal "$src_data" "$dst_data"
	mkfs.ext4 -F -L data -m 0 -E lazy_itable_init=1 /dev/md10
	mkdir -p /srv/data
	grep -q '^/dev/md10' /etc/fstab ||
		echo '/dev/md10        /srv/data      ext4    defaults,noatime,nofail    0      2' >> /etc/fstab
	systemctl daemon-reload
	mount /srv/data
fi

mdadm --detail --scan > /etc/mdadm/mdadm.conf.new
{ echo "# Generated by rn212-mirror-disk"; echo "HOMEHOST <system>"; cat /etc/mdadm/mdadm.conf.new; } > /etc/mdadm/mdadm.conf
rm -f /etc/mdadm/mdadm.conf.new

echo
echo "Done. Resync runs in the background (cat /proc/mdstat):"
cat /proc/mdstat
